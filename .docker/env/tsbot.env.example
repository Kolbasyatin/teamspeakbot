# Конфигурация приложения. Скопировать в tsbot.env и заполнить.
# В прод-compose монтируется внутрь контейнера как /app/.env.local (его читает dotenv-flow);
# в дев-compose тот же файл подключается через env_file для сервиса app (профиль `app`).
# Реальный файл гитигнорится: здесь живёт токен бота.
#
# Паролей БД и ServerQuery здесь НЕТ: одно и то же значение, вписанное в два файла, рано или
# поздно разъезжается. Они заданы один раз в secrets.env, а прод-compose передаёт их контейнеру
# переменными окружения — те перебивают этот файл. Заполнять TS_PASSWORD/DB_PASSWORD нужно
# только при запуске вне прод-compose (дев-профиль `app`).
#
# Полное описание всех переменных — в AGENTS.md, §5.

# --- TeamSpeak (ServerQuery over SSH) ---
# Внутри сети compose хост — это имя сервиса: teamspeak. При запуске приложения на хосте — 127.0.0.1.
TS_HOST=teamspeak
TS_PORT=10022
TS_USERNAME=serveradmin
# В проде подставляется из secrets.env (TS_QUERY_ADMIN_PASSWORD).
TS_PASSWORD=

# --- Каналы доставки уведомлений ---
TEAMSPEAK_NOTIFIER=true
LOG_NOTIFIER=true
TELEGRAM_NOTIFIER=true

# Имена каналов TeamSpeak, в описание которых пишется табло состояния (через запятую).
TS_NOTIFY_CHANNELS=ServerInfo

# --- Telegram ---
# Пустой TELEGRAM_TOKEN отключает Telegram целиком: ни команд, ни уведомлений (это не падение).
TELEGRAM_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- База данных ---
# Внутри сети compose хост — имя сервиса mariadb и внутренний порт 3306.
DB_HOST=mariadb
DB_PORT=3306
DB_USER=teamspeak
# В проде подставляется из secrets.env (TS_DB_PASSWORD).
DB_PASSWORD=
DB_NAME=tsbot
DB_CONNECTION_LIMIT=2

# --- Мониторинг ---
MONITOR_POLL_INTERVAL_MS=5000
MONITOR_SUSPICIOUS_POLL_INTERVAL_MS=1000
MONITOR_MAX_FAILED_CHECKS=5
# Сколько ждать второстепенные источники ПОСЛЕ ответа главного
MONITOR_SECONDARY_GRACE_MS=1000
# Период повторной публикации текущего состояния (итерация 8): лечит упавшую доставку
# и откатывает правку описания канала, сделанную руками.
MONITOR_STATE_SYNC_INTERVAL_MS=60000
# Не чаще какого интервала опрашивать один второстепенный источник (каталог Bohemia)
MONITOR_SECONDARY_POLL_INTERVAL_MS=30000

# --- Каталог серверов Bohemia (очередь на вход) ---
# Сервис токенов входит в тот же прод-compose (сервис bohemia-token, контейнер arma-reforger-hz)
# и резолвится по имени в сети проекта — см. .docker/README.md, раздел «Сервис токенов Bohemia».
# Пусто — очередь не собирается, всё остальное работает. Сервис недоступен — то же самое,
# без падений.
BOHEMIA_TOKEN_URL=http://arma-reforger-hz:8080/token

# --- Admin HTTP ---
SYNC_SERVER_PORT=3000
