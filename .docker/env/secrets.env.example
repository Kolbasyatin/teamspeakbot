# Пароли для подстановки в compose.prod.yaml (${...}). Скопировать в secrets.env и заполнить.
# Реальный файл гитигнорится и на прод-машину переносится вручную.
#
# Использование: docker compose --env-file env/secrets.env -f compose.prod.yaml up -d

# Пароль пользователя teamspeak в MariaDB. Одно и то же значение используют TeamSpeak-сервер
# и приложение — они ходят одним пользователем. В приложение compose передаёт его сам
# (DB_PASSWORD у migrate и ts-monitoring), в tsbot.env дублировать не нужно.
TS_DB_PASSWORD=

# Пароль root в MariaDB. Нужен только для администрирования базы.
MARIADB_ROOT_PASSWORD=

# Пароль ServerQuery-админа (serveradmin) TeamSpeak. Задаётся явно, иначе образ сгенерирует его
# при первом запуске и напишет в лог. Это же значение — то, чем ходят руками по SSH на порт 10022,
# и то, что compose передаёт приложению как TS_PASSWORD. Источник один, дублировать не нужно.
TS_QUERY_ADMIN_PASSWORD=
