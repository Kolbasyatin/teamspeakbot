# Пароли для подстановки в compose.prod.yaml (${...}). Скопировать в secrets.env и заполнить.
# Реальный файл гитигнорится и на прод-машину переносится вручную.
#
# Использование: docker compose --env-file env/secrets.env -f compose.prod.yaml up -d

# Пароль пользователя teamspeak в MariaDB. Одно и то же значение используют TeamSpeak-сервер
# и приложение — они ходят одним пользователем. В приложение compose передаёт его сам
# (DB_PASSWORD у migrate и ts-monitoring), в tsbot.env дублировать не нужно.
TS_DB_PASSWORD=

# Пароль root в MariaDB. Нужен только для администрирования базы.
MARIADB_ROOT_PASSWORD=

# Пароль ServerQuery-админа (serveradmin) TeamSpeak. Задаётся явно, иначе образ сгенерирует его
# при первом запуске и напишет в лог. Это же значение — то, чем ходят руками по SSH на порт 10022,
# и то, что compose передаёт приложению как TS_PASSWORD. Источник один, дублировать не нужно.
TS_QUERY_ADMIN_PASSWORD=

# Токен REST API соседнего сервиса наблюдения за игроками (armaplayers): его API_TOKEN.
# Нужен командам /watch, /players, /where, /history и уведомлениям о входе и выходе игроков.
# Пусто — сосед не опрашивается, мониторинг серверов работает как раньше.
# Значение compose передаёт приложению сам (PLAYERS_API_TOKEN у ts-monitoring),
# в tsbot.env дублировать не нужно.
PLAYERS_API_TOKEN=

# Ключ Steam Web API (steamcommunity.com/dev/apikey; требует мобильного аутентификатора
# на аккаунте, лимит 100 000 вызовов в сутки). Нужен эндпоинту /steam/{steamId64} сервиса
# arma-reforger-hz: профиль, друзья, наигранное и баны игрока по его SteamID64.
# К Steam-логину для билета Bohemia отношения не имеет — это обычный публичный API Valve.
# Compose передаёт его сам (SteamWebApi__ApiKey у bohemia-token). Пусто — эндпоинт отвечает 503.
STEAM_WEB_API_KEY=
