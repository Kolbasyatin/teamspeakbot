# Дев-окружение. Читается только при NODE_ENV=dev — его выставляют `npm run dev` и `npm run migrate`.
# Порядок dotenv-flow, позже = важнее: .env → .env.local → .env.dev → .env.dev.local
#
# Здесь только то, чего НЕТ в .env, — дев-пароли из .docker/compose.dev.yaml. Прятать их незачем:
# они прописаны открытым текстом в самом compose и одинаковы у всех, кто поднимает дев-стек.
# Всё остальное (хосты, порты, база, интервалы) берётся из .env и дублироваться здесь не должно.
#
# Личное — токен бота, свой чат, включение Telegram — в .env.dev.local, он гитигнорится.

# Пароль пользователя teamspeak в MariaDB: MARIADB_PASSWORD в compose.dev.yaml.
DB_PASSWORD=mypassword

# Пароль ServerQuery-админа TeamSpeak: TSSERVER_QUERY_ADMIN_PASSWORD в compose.dev.yaml.
# Нужен, только когда поднят профиль `teamspeak`.
TS_PASSWORD=devquery
