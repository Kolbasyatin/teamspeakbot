# Базовая конфигурация для запуска НА ХОСТЕ. Файл в репозитории, поэтому настоящих паролей
# здесь нет: там, где нужен секрет, стоит changeme.
#
# В прод этот файл не попадает: Dockerfile копирует только package*.json, tsconfig, src и dist,
# а конфигурация приезжает томом как /app/.env.local (см. .docker/README.md). Так что всё ниже —
# про локальную работу и про значения по умолчанию.
#
# Порядок загрузки dotenv-flow, позже = важнее:
#     .env  →  .env.local  →  .env.<NODE_ENV>  →  .env.<NODE_ENV>.local
# NODE_ENV выставляют сами npm-скрипты: `dev` и `migrate` → dev, `test` → test.
# Отсюда раскладка:
#     .env             это файл, общая база
#     .env.dev         дев-значения из .docker/compose.dev.yaml (в репозитории)
#     .env.test        тестовая база (в репозитории)
#     .env.dev.local   личное: токен бота, свой чат (гитигнорится)
#
# Полное описание всех переменных — в AGENTS.md, §5.

# --- TeamSpeak (ServerQuery over SSH) ---
# Дев-контейнер поднимается профилем `teamspeak` и слушает 10022 с паролем devquery —
# эти значения уже стоят в .env.dev, здесь их дублировать не нужно.
TS_HOST=127.0.0.1
TS_PORT=10022
TS_USERNAME=serveradmin
TS_PASSWORD=changeme
# Потолок одной операции TeamSpeak вместе с подключением. У библиотеки своего таймаута нет:
# при оборванном соединении команда висела бы вечно, а вместе с ней /who и весь приём команд бота.
TS_QUERY_TIMEOUT_MS=10000

# Имена каналов TeamSpeak, в описание которых пишется табло состояния. Через запятую.
TS_NOTIFY_CHANNELS=ServerInfo

# --- Каналы доставки уведомлений ---
# Выключены по умолчанию все, кроме журнала: база не должна сама по себе начать писать
# в чужой TeamSpeak или в Telegram-канал. Включается осознанно в своём окружении.
TEAMSPEAK_NOTIFIER=false
LOG_NOTIFIER=true
TELEGRAM_NOTIFIER=false

# --- Telegram ---
# Пустой TELEGRAM_TOKEN отключает Telegram целиком — ни команд, ни уведомлений.
# Это штатное состояние, а не ошибка: в лог уходит сообщение и приложение работает дальше.
# Свой токен и свой чат класть в .env.dev.local, а не сюда.
TELEGRAM_TOKEN=
TELEGRAM_CHANNEL_ID=
# Сколько ждать обработчик одного апдейта (команда, кнопка), прежде чем бот пойдёт за следующими.
# grammy обрабатывает апдейты по очереди, поэтому без потолка один повисший обработчик останавливал
# приём команд целиком. Должен быть больше самого долгого законного ответа (досье игрока — до 30 с).
TELEGRAM_UPDATE_TIMEOUT_MS=60000

# --- База данных ---
# Дев-база поднимается из .docker/compose.dev.yaml и слушает localhost:3306; пользователь
# и пароль — в .env.dev. Базы tsbot и tsbot_test создаёт .docker/mariadb/init/01-databases.sql
# при ПЕРВОЙ инициализации тома.
DB_HOST=localhost
DB_PORT=3306
DB_USER=teamspeak
DB_PASSWORD=changeme
DB_NAME=tsbot
DB_CONNECTION_LIMIT=2

# --- Мониторинг ---
# Обычный интервал опроса сервера.
MONITOR_POLL_INTERVAL_MS=5000
# Учащённый интервал после неудачной попытки: пока сервер под подозрением, проверяем чаще,
# чтобы не объявить его упавшим из-за одного потерянного пакета.
MONITOR_SUSPICIOUS_POLL_INTERVAL_MS=1000
# Сколько неудач подряд переводят сервер в offline.
MONITOR_MAX_FAILED_CHECKS=5
# Сколько ждать второстепенные источники ПОСЛЕ ответа главного. Отсчёт именно от его ответа,
# иначе быстрые второстепенные съедали бы бюджет главного.
MONITOR_SECONDARY_GRACE_MS=1000
# Период повторной публикации текущего состояния: лечит упавшую доставку и откатывает
# правку описания канала, сделанную в TeamSpeak руками.
MONITOR_STATE_SYNC_INTERVAL_MS=60000
# Не чаще какого интервала опрашивать один второстепенный источник (каталог Bohemia обновляется
# heartbeat'ом раз в десятки секунд). Между опросами в слияние идёт его прошлый ответ. 0 — каждый тик.
MONITOR_SECONDARY_POLL_INTERVAL_MS=30000

# --- Каталог серверов Bohemia (очередь на вход) ---
# GET /token соседнего сервиса arma-reforger-hz. Пусто — источники bohemia молчат, остальное работает.
# Локально сосед крутится в docker с проброшенным портом: положить http://localhost:8080/token
# в .env.dev.local. Протокольные константы (BOHEMIA_USER_AGENT, BOHEMIA_CLIENT_VERSION и другие)
# имеют умолчания в properties.ts и меняются с патчами игры — см. AGENTS.md, §5.
BOHEMIA_TOKEN_URL=

# Соседний сервис наблюдения за игроками (armaplayers, репозиторий arma-players-backend):
# команды /watch, /players, /where, /history и уведомления о входе и выходе игроков.
# Пусто — тема выключена целиком, мониторинг серверов работает как раньше.
# Локально сосед слушает на своём порту, токен — тот, что лежит у него в API_TOKEN.
# Класть значения в .env.dev.local, а не сюда.
PLAYERS_API_URL=
PLAYERS_API_TOKEN=

# Как часто спрашивать новые события у наблюдателя. Задержка уведомления складывается из этого
# интервала и интервала наблюдения на его стороне (там минуты), поэтому чаще смысла нет.
PLAYERS_EVENT_INTERVAL_MS=15000

# Как часто перепроверять отложенные подписки («появится игрок с таким ником — подпиши меня»)
# и сколько такое ожидание живёт.
PLAYERS_PENDING_INTERVAL_MS=300000
PLAYERS_PENDING_TTL_MS=2592000000

# --- Admin HTTP ---
# POST /internal/reload-servers и /internal/force-reload-servers — перечитать список серверов.
SYNC_SERVER_PORT=3000
