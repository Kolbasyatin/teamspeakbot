{
  "name": "tsbot",
  "version": "1.0.0",
  "private": true,
  "description": "TeamSpeak automation daemon",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "NODE_ENV=test tsx --import dotenv-flow/config --test src/*/*.test.ts",
    "test:unit": "NODE_ENV=test tsx --test src/monitoring/*.test.ts src/notifications/*.test.ts src/queriers/*.test.ts",
    "test:repo": "NODE_ENV=test tsx --import dotenv-flow/config --test src/persistence/*.test.ts"
  },
  "keywords": [
    "teamspeak",
    "daemon",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@callowayisweird/source-query": "^0.1.0",
    "@types/ssh2": "^1.15.5",
    "convict": "^6.2.5",
    "date-fns": "^4.1.0",
    "dotenv-flow": "^4.1.0",
    "grammy": "^1.42.0",
    "mariadb": "^3.5.2",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "ts3-nodejs-library": "^3.5.2"
  }
}
